  "types": [
    {
      "name": "HookConfig",
      "docs": [
        "Admin-controlled config that defines which SAS credential and schema",
        "are required to transfer this token. Stored per-mint."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Admin who can update this config"
            ],
            "type": "pubkey"
          },
          {
            "name": "credential",
            "docs": [
              "SAS Credential account pubkey"
            ],
            "type": "pubkey"
          },
          {
            "name": "schema",
            "docs": [
              "SAS Schema account pubkey"
            ],
            "type": "pubkey"
          },
          {
            "name": "sas_program",
            "docs": [
              "SAS program ID"
            ],
            "type": "pubkey"
          },
          {
            "name": "bump",
            "docs": [
              "Bump for this PDA"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "WhitelistEntry",
      "docs": [
        "Marks a wallet as whitelisted for a given mint, bypassing attestation checks.",
        "PDA seeds: [\"whitelist\", mint, wallet]"
